# LLM (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_ID=moonshotai/kimi-k2.5

# Server
PORT=8787

# Ingest / analysis limits
MAX_TRANSCRIPTS=8
TRANSCRIPT_CHAR_CAP=80000
LLM_TOTAL_CHAR_BUDGET=220000
USER_AGENT=Mozilla/5.0 (compatible; ConcallAnalysis/0.1; +https://github.com/babaism21/Concall-analysis)

# Postgres (canonical read store)
USE_POSTGRES=true
DATABASE_URL=postgresql://concall:concall@localhost:5432/concall
